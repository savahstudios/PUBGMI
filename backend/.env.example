# ─────────────────────────────────────────────
#  PUBGMI BOT — BACKEND ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in all values
# ─────────────────────────────────────────────

# SERVER
NODE_ENV=production
PORT=3000

# SECURITY — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_64_chars
SESSION_SALT=your_session_salt_here_minimum_64_chars
COOKIE_SECRET=your_cookie_secret_here

# DATABASE (Railway PostgreSQL — copy from Railway dashboard)
DATABASE_URL=postgresql://user:password@host:port/database

# REDIS (Railway Redis — copy from Railway dashboard)
REDIS_URL=redis://default:password@host:port

# ─────────────────────────────────────────────
#  YOUTUBE — ACCOUNT 1 (Main Channel: PUBGMI)
# ─────────────────────────────────────────────
YOUTUBE_CLIENT_ID_1=your_oauth_client_id
YOUTUBE_CLIENT_SECRET_1=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN_1=auto_populated_after_auth

# ─────────────────────────────────────────────
#  YOUTUBE — ACCOUNT 2 (Second Channel)
# ─────────────────────────────────────────────
YOUTUBE_CLIENT_ID_2=your_oauth_client_id
YOUTUBE_CLIENT_SECRET_2=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN_2=auto_populated_after_auth

# ─────────────────────────────────────────────
#  YOUTUBE — BOT ACCOUNT (posts in chat)
# ─────────────────────────────────────────────
BOT_CLIENT_ID=your_bot_oauth_client_id
BOT_CLIENT_SECRET=your_bot_oauth_client_secret
BOT_REFRESH_TOKEN=auto_populated_after_auth

# YOUTUBE API KEY (from Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key

# ─────────────────────────────────────────────
#  TELEGRAM
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Comma-separated numeric Telegram user IDs (no spaces)
AUTHORIZED_TELEGRAM_IDS=123456789,987654321

# ─────────────────────────────────────────────
#  APP URLS
# ─────────────────────────────────────────────
FRONTEND_URL=https://pubgmi.vercel.app
BACKEND_URL=https://your-app.railway.app

# WEBSUB (YouTube push notifications)
WEBSUB_SECRET=your_random_websub_secret
WEBSUB_CALLBACK_URL=https://your-app.railway.app/webhooks/youtube

# MAINTENANCE MODE (set to true to enable)
MAINTENANCE_MODE=false

# BOT USAGE GUIDE INTERVAL (seconds — default 600 = 10 minutes)
BOT_GUIDE_INTERVAL=600
