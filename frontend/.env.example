# ─────────────────────────────────────────────
#  PUBGMI BOT — FRONTEND ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in all values
# ─────────────────────────────────────────────

# Backend API URL (Railway backend URL)
VITE_BACKEND_URL=https://your-app.railway.app

# Telegram Bot username (without @)
VITE_TELEGRAM_BOT_USERNAME=PUBGMIROBOT

# App name
VITE_APP_NAME=PUBGMI

# Dashboard URL (your Vercel subdomain)
VITE_APP_URL=https://pubgmi.vercel.app
